#################################################################

###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#areaTotal
:areaTotal rdf:type owl:DatatypeProperty ;
           rdfs:domain :AlojamientoCompleto ;
           rdfs:range xsd:double .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#calificacionPromedio
:calificacionPromedio rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Propiedad ;
                      rdfs:range xsd:decimal .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#capacidadDormitorio
:capacidadDormitorio rdf:type owl:DatatypeProperty ;
                     rdfs:domain :HabitacionCompartida ;
                     rdfs:range xsd:int .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#capacidadEventos
:capacidadEventos rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Villa ;
                  rdfs:range xsd:int .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#capacidadMaxima
:capacidadMaxima rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Propiedad ;
                 rdfs:range xsd:int .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#categoriaAmenidad
:categoriaAmenidad rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Amenidad ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:oneOf [ rdf:type rdf:List ;
                                            rdf:first "Accesibilidad" ;
                                            rdf:rest [ rdf:type rdf:List ;
                                                       rdf:first "Alimentacion" ;
                                                       rdf:rest [ rdf:type rdf:List ;
                                                                  rdf:first "Cocina" ;
                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                             rdf:first "Conectividad" ;
                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                        rdf:first "Confort" ;
                                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                                   rdf:first "Recreativa" ;
                                                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                                                              rdf:first "Seguridad" ;
                                                                                                              rdf:rest [ rdf:type rdf:List ;
                                                                                                                         rdf:first "Servicio" ;
                                                                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                                                                    rdf:first "TrabajoRemoto" ;
                                                                                                                                    rdf:rest [ rdf:type rdf:List ;
                                                                                                                                               rdf:first "Transporte" ;
                                                                                                                                               rdf:rest rdf:nil
                                                                                                                                             ]
                                                                                                                                  ]
                                                                                                                       ]
                                                                                                            ]
                                                                                                 ]
                                                                                      ]
                                                                           ]
                                                                ]
                                                     ]
                                          ]
                              ] .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#ciudad
:ciudad rdf:type owl:DatatypeProperty ;
        rdfs:domain :ZonaGeografica ;
        rdfs:range xsd:string .


