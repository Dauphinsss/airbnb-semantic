<http://www.semanticweb.org/steven/ontologies/2026/2/airbnb> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#compatibleCon
:compatibleCon rdf:type owl:ObjectProperty ;
               rdfs:domain :Propiedad ;
               rdfs:range :PerfilHuesped .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#tieneAmenidad
:tieneAmenidad rdf:type owl:ObjectProperty ;
               rdfs:domain :Propiedad ;
               rdfs:range :Amenidad .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#tienePolitica
:tienePolitica rdf:type owl:ObjectProperty ;
               rdfs:domain :Propiedad ;
               rdfs:range :Politica .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#tienePropositoViaje
:tienePropositoViaje rdf:type owl:ObjectProperty ;
                     rdfs:domain :PerfilHuesped ;
                     rdfs:range :PropositoViaje .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#tienePuntoInteres
:tienePuntoInteres rdf:type owl:ObjectProperty ;
                   rdfs:domain :ZonaGeografica ;
                   rdfs:range :PuntoInteres .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#ubicadaEn
:ubicadaEn rdf:type owl:ObjectProperty ;
           rdfs:domain :Propiedad ;
           rdfs:range :ZonaGeografica .


