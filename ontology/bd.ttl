:costoAdicional rdf:type owl:DatatypeProperty ;
                rdfs:domain :Amenidad ;
                rdfs:range xsd:decimal .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#densidadUrbana
:densidadUrbana rdf:type owl:DatatypeProperty ;
                rdfs:domain :ZonaGeografica ;
                rdfs:range [ rdf:type rdfs:Datatype ;
                             owl:oneOf [ rdf:type rdf:List ;
                                         rdf:first "Alta" ;
                                         rdf:rest [ rdf:type rdf:List ;
                                                    rdf:first "Baja" ;
                                                    rdf:rest [ rdf:type rdf:List ;
                                                               rdf:first "Media" ;
                                                               rdf:rest [ rdf:type rdf:List ;
                                                                          rdf:first "MuyAlta" ;
