###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#tipoZona
:tipoZona rdf:type owl:DatatypeProperty ;
          rdfs:domain :ZonaGeografica ;
          rdfs:range [ rdf:type rdfs:Datatype ;
                       owl:oneOf [ rdf:type rdf:List ;
                                   rdf:first "Costera" ;
                                   rdf:rest [ rdf:type rdf:List ;
                                              rdf:first "Montana" ;
                                              rdf:rest [ rdf:type rdf:List ;
                                                         rdf:first "Rural" ;
                                                         rdf:rest [ rdf:type rdf:List ;
                                                                    rdf:first "Urbana" ;
                                                                    rdf:rest rdf:nil
                                                                  ]
                                                       ]
                                            ]
                                 ]
                     ] .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#AlojamientoCompleto
:AlojamientoCompleto rdf:type owl:Class ;
                     rdfs:subClassOf :Propiedad ;
                     owl:disjointWith :AlojamientoHabitacion .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#AlojamientoHabitacion
:AlojamientoHabitacion rdf:type owl:Class ;
                       rdfs:subClassOf :Propiedad .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#Amenidad
:Amenidad rdf:type owl:Class .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#Apartamento
:Apartamento rdf:type owl:Class ;
             rdfs:subClassOf :AlojamientoCompleto .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#Casa
:Casa rdf:type owl:Class ;
      rdfs:subClassOf :AlojamientoCompleto .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#HabitacionCompartida
:HabitacionCompartida rdf:type owl:Class ;
                      rdfs:subClassOf :AlojamientoHabitacion ;
                      owl:disjointWith :HabitacionPrivada .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#HabitacionPrivada
:HabitacionPrivada rdf:type owl:Class ;
                   rdfs:subClassOf :AlojamientoHabitacion .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#PerfilHuesped
:PerfilHuesped rdf:type owl:Class .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#Politica
:Politica rdf:type owl:Class .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#Propiedad
:Propiedad rdf:type owl:Class .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#PropositoViaje
:PropositoViaje rdf:type owl:Class .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#PuntoInteres
:PuntoInteres rdf:type owl:Class .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#Villa
:Villa rdf:type owl:Class ;
       rdfs:subClassOf :AlojamientoCompleto .


###  http://www.semanticweb.org/steven/ontologies/2026/2/airbnb#ZonaGeografica
:ZonaGeografica rdf:type owl:Class .


